# Copy to .env and fill in. NEVER commit the real .env.

# ---- LLM access (model-agnostic interface) ----
LLM_PROVIDER=anthropic           # anthropic | openai | local
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=                     # set locally; keep a per-run spend cap
LLM_MAX_SPEND_USD=5              # hard budget cap per evaluation run

# ---- Incident / audit store ----
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# ---- Observability endpoints (read-only) ----
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
ELASTICSEARCH_URL=http://localhost:9200

# ---- Kubernetes ----
KUBECONFIG=./kubeconfig
TARGET_NAMESPACE=online-boutique

# ---- Safety: restricted executor ----
# Only these namespaces may ever receive a write action.
NAMESPACE_ALLOWLIST=online-boutique
